<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ecopoint | History</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles/contributor.css">
    <link rel="icon" href="/images/EcoPoint.png" type="image/x-icon">
</head>
<body>
    <header class="header">
        <h1>Ecopoint</h1>
        <nav class="nav">
          <a href="/">Home</a>
        </nav>
      </header>
    <div class="container mt-5">
        <h1 class="text-center mb-4">Submission History</h1>

        <% if (submissions.length > 0) { %>
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>Collector Name</th>
                        <th>Product Name</th>
                        <th>Points</th>
                    </tr>
                </thead>
                <tbody>
                    <% submissions.forEach(submission => { %>
                        <tr>
                            <td><%= new Date(submission.submission_date).toLocaleString() %></td>
                            <td><%= submission.collector_id.name %></td>
                            <td><%= submission.productName %></td>
                            <td><%= submission.productPoint %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <!-- Pagination Controls -->
            <div class="pagination-container">
                <% if (currentPage > 1) { %>
                    <a href="?page=<%= currentPage - 1 %>" class="pagination-link">Previous</a>
                <% } %>
                Page <%= currentPage %> of <%= totalPages %>
                <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %>" class="pagination-link">Next</a>
                <% } %>
            </div>
        <% } else { %>
            <p class="text-center mt-4">No submissions found.</p>
        <% } %>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>