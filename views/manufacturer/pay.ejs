<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ecopoint | Pay User</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="/styles/manufacturer.css">
  <link rel="icon" href="/images/EcoPoint.png" type="image/x-icon">
</head>

<body>
  <%- include('../partials/sidebar', { currentPage: 'pay' }) %>
    <div class="wrapper">



      <button id="connectWallet" class="btn btn-dark btn-md mt-10" style="display: block;">Connect Wallet</button>

      <form action="/manufacturer/confirmPayment" method="POST" id="makePayment" style="display: none;">
        <label>User's Name:</label>
        <input type="text" id="userName" name="userName" value="<%= userName %>" readonly><br><br>

        <label for="publicKey">Wallet Address:</label>
        <input type="text" id="publicKey" name="publicKey" value="<%= publicKey %>" readonly><br><br>

        <label for="amount">Amount (SOL):</label>
        <input type="number" id="amount" name="amount" value="<%= amount %>" readonly><br><br>

        <input type="hidden" id="userId" name="userId" value="<%= userId %>">
        <input type="hidden" id="manufacturerId" name="manufacturerId" value="<%= manufacturerId %>">

        <!-- <button type="submit">Make Payment</button> -->
        <button id="payButton" type="submit">Pay with Solana Pay</button>
      </form>

    </div>
    <%- include('../partials/footer') %>

      <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
      <script src="../js/script.js"></script>
</body>

</html>