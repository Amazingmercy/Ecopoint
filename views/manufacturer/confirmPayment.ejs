<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Successful</title>
  <link rel="stylesheet" href="/styles/manufacturer.css">
  <link rel="icon" href="/images/EcoPoint.png" type="image/x-icon">
</head>

<body>
  <div class="payment-successful-container">
    <h1>Payment Successful!</h1>
    <div class="success-icon">
      <i class="fas fa-check-circle"></i>
    </div>
    <p>Congratulations! Your payment has been processed successfully.</p>
    <p>Amount: <%= amount %> SOL</p>
    <p>Recipient: <%=userName %>
    </p>
    <a href="/manufacturer/dashboard" class="return-to-dashboard">Return to Dashboard</a>
  </div>
</body>

</html>